# ==============================================================================
# Röpdolgozat program - .gitignore
# 100% Offline Helyi Hálózatos Röpdolgozat Rendszer (Socrative-klón)
# ==============================================================================

# Függőségek (Dependencies)
node_modules/
package-lock.json.backup

# SQLite adatbázis és WAL fájlok (Adatvédelem és futásidejű állapotok)
data/*.db
data/*.db-wal
data/*.db-shm
data/*.db-journal
*.sqlite
*.sqlite3
*.db

# Dinamikusan feltöltött médiafájlok (a .gitkeep fájl kivételével)
data/uploads/*
!data/uploads/.gitkeep

# Biztonsági mentések és exportált archívumok (Backups & Exports)
backups/
*.zip
*.tar.gz

# Naplófájlok (Logs)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Környezeti beállítások és titkos kulcsok (Environment & Secrets)
.env
.env.local
.env.*.local

# Operációs rendszer és fejlesztői környezet fájljai (OS & IDE)
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# Ideiglenes fájlok és gyorsítótárak (Temp & Cache)
tmp/
temp/

